# 复制为 deploy/.env 后：docker compose --env-file deploy/.env up -d
# 修改 POSTGRES_PASSWORD 时须同步改 deploy/config.docker.yaml 里 database.dsn 中的密码
APP_PORT=9000
WEB_PORT=8080
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc
# 预留：若 Redis 启用 requirepass，在此填写并与 deploy/config.docker.yaml 中 redis.password 一致
# REDIS_PASSWORD=
